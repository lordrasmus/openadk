+ *             pid_t *ptid, void *tls, pid_t *ctid);
+ * r7 is taken by regs, so the C library passes ctid in r6 instead of tls,
+ * which lm32 has no use for. */
 asmlinkage int sys_clone(
 		int _unused_fn,
 		unsigned long newsp,
 		unsigned long clone_flags,
 		int _unused_arg,
-		unsigned long _unused_r5,
