+
+   Under Section 7 of GPL version 3, you are granted additional
+   permissions described in the GCC Runtime Library Exception, version
+   3.1, as published by the Free Software Foundation.
+
+   You should have received a copy of the GNU General Public License and
+   a copy of the GCC Runtime Library Exception along with this program;
+   see the files COPYING3 and COPYING.RUNTIME respectively.  If not, see
+   <http://www.gnu.org/licenses/>.  */
+
+#ifndef inhibit_libc
+
+/* Recognize the sigreturn trampoline the kernel returns a signal
+   handler to, and describe the interrupted context from the signal frame
+   it sits behind.  */
+
+#include <signal.h>
+#include <asm/unistd.h>
+
+/* movu.w <nr>,$r9; break 13 -- on the stack for CRIS v10, in the signal
+   return page for v32 (sigreturn at +0, rt_sigreturn at +6).  */
+#define CRIS_MOVU_W_R9	0x9c5f
+#define CRIS_BREAK_13	0xe93d
+
+/* The kernel's frames.  The handler is entered with the stack pointer
+   at the frame, so the frame is the CFA of the handler.  */
+struct cris_kernel_ucontext
+{
+  unsigned long uc_flags;
+  void *uc_link;
+  stack_t uc_stack;
+  struct sigcontext uc_mcontext;
+};
+
+struct cris_rt_sigframe
+{
+  void *pinfo;
+  void *puc;
+  siginfo_t info;
+  struct cris_kernel_ucontext uc;
+};
+
+#define MD_FALLBACK_FRAME_STATE_FOR cris_fallback_frame_state
+
+static _Unwind_Reason_Code
+cris_fallback_frame_state (struct _Unwind_Context *context,
+			   _Unwind_FrameState *fs)
+{
+  unsigned short *pc = (unsigned short *) context->ra;
+  struct sigcontext *sc;
+  struct pt_regs *regs;
+  _Unwind_Ptr new_cfa;
+
+  if (pc[0] != CRIS_MOVU_W_R9 || pc[2] != CRIS_BREAK_13)
+    return _URC_END_OF_STACK;
+
+  if (pc[1] == __NR_sigreturn)
+    sc = (struct sigcontext *) context->cfa;
+  else if (pc[1] == __NR_rt_sigreturn)
+    sc = &((struct cris_rt_sigframe *) context->cfa)->uc.uc_mcontext;
+  else
+    return _URC_END_OF_STACK;
+
+  regs = &sc->regs;
+  new_cfa = sc->usp;
+  fs->regs.cfa_how = CFA_REG_OFFSET;
+  fs->regs.cfa_reg = __LIBGCC_STACK_POINTER_REGNUM__;
+  fs->regs.cfa_offset = new_cfa - (_Unwind_Ptr) context->cfa;
+
+#define CRIS_SAVED(column, field)					\
+  do									\
+    {									\
+      fs->regs.reg[column].how = REG_SAVED_OFFSET;			\
+      fs->regs.reg[column].loc.offset					\
+	= (_Unwind_Ptr) &regs->field - new_cfa;				\
+    }									\
+  while (0)
+
+  CRIS_SAVED (0, r0);
+  CRIS_SAVED (1, r1);
+  CRIS_SAVED (2, r2);
+  CRIS_SAVED (3, r3);
+  CRIS_SAVED (4, r4);
+  CRIS_SAVED (5, r5);
+  CRIS_SAVED (6, r6);
+  CRIS_SAVED (7, r7);
+  CRIS_SAVED (8, r8);
+  CRIS_SAVED (9, r9);
+  CRIS_SAVED (10, r10);
+  CRIS_SAVED (11, r11);
+  CRIS_SAVED (12, r12);
+  CRIS_SAVED (13, r13);
+#ifdef __arch_v32
+  CRIS_SAVED (15, acr);
+#endif
+  CRIS_SAVED (16, srp);
+  CRIS_SAVED (17, mof);
+
+  /* The interrupted PC gets a column of its own: SRP keeps its value.  */
+#ifdef __arch_v32
+  CRIS_SAVED (__LIBGCC_DWARF_ALT_FRAME_RETURN_COLUMN__, erp);
+#else
+  CRIS_SAVED (__LIBGCC_DWARF_ALT_FRAME_RETURN_COLUMN__, irp);
+#endif
+#undef CRIS_SAVED
+
+  fs->retaddr_column = __LIBGCC_DWARF_ALT_FRAME_RETURN_COLUMN__;
+  fs->signal_frame = 1;
+  return _URC_NO_REASON;
+}
+
+#endif /* ifdef inhibit_libc  */
