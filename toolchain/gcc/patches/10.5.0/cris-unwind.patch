cris: unwind through signal frames on Linux

libgcc had no MD_FALLBACK_FRAME_STATE_FOR for CRIS, so the unwinder
stopped at the sigreturn trampoline: thread cancellation, which unwinds
from the SIGCANCEL handler, could not run the cleanups of code built
with -fexceptions.  Recognize "movu.w <nr>,$r9; break 13" with
__NR_sigreturn or __NR_rt_sigreturn and describe the interrupted
context from the kernel's sigcontext; the interrupted PC goes into its
own column (DWARF_ALT_FRAME_RETURN_COLUMN), so SRP keeps its value.

diff --git a/gcc/config/cris/linux.h b/gcc/config/cris/linux.h
index 3bb6f68..78fa8f8 100644
--- a/gcc/config/cris/linux.h
+++ b/gcc/config/cris/linux.h
@@ -102,6 +102,11 @@ along with GCC; see the file COPYING3.  If not see
 #undef CRIS_DEFAULT_CPU_VERSION
 #define CRIS_DEFAULT_CPU_VERSION CRIS_CPU_NG
 
+/* The column the signal frame unwinder of libgcc (linux-unwind.h) puts
+   the interrupted PC in; SRP keeps its own value there.  One beyond the
+   hard registers, which the unwinder's tables leave room for.  */
+#define DWARF_ALT_FRAME_RETURN_COLUMN FIRST_PSEUDO_REGISTER
+
 #define GLIBC_DYNAMIC_LINKER "/lib/ld.so.1"
 
 #undef CRIS_LINK_SUBTARGET_SPEC
diff --git a/libgcc/config.host b/libgcc/config.host
index 21240f7..c75963b 100644
--- a/libgcc/config.host
+++ b/libgcc/config.host
@@ -613,6 +613,7 @@ cris-*-elf)
 	;;
 cris-*-linux* | crisv32-*-linux*)
 	tmake_file="$tmake_file cris/t-cris t-softfp-sfdf t-softfp cris/t-linux"
+	md_unwind_header=cris/linux-unwind.h
 	;;
 csky-*-elf*)
 	tmake_file="csky/t-csky t-fdpbit"
diff --git a/libgcc/config/cris/linux-unwind.h b/libgcc/config/cris/linux-unwind.h
new file mode 100644
index 0000000..c0155a0
--- /dev/null
+++ b/libgcc/config/cris/linux-unwind.h
@@ -0,0 +1,126 @@
