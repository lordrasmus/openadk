+/* True if X is a thread-local symbol, possibly plus an offset.  */
+
+bool
+cris_tls_symbol_p (rtx x)
+{
+  return ((SYMBOL_REF_P (x) || GET_CODE (x) == CONST)
+	  && cris_symbol_type_of (x) == cris_tls_symbol);
+}
+
+/* Return a register with the address of the thread-local symbol X
+   (possibly plus an offset).  The layout is TLS variant II with the
+   thread pointer in $pid, as binutils implements it for v32, and in r6
+   on v10.  Only the models
+   of an executable are generated: local-exec, and initial-exec for the
+   others, which is all a static program needs.  With PIC everything is
+   initial-exec: gas takes TPOFF only without --pic.  */
+
+rtx
+cris_legitimize_tls_address (rtx x)
+{
+  rtx sym = x, tp, off, res;
+  HOST_WIDE_INT offs = 0;
+
+  if (GET_CODE (x) == CONST)
+    {
+      sym = get_related_value (x);
+      offs = get_integer_term (x);
+    }
+  gcc_assert (SYMBOL_REF_P (sym) && SYMBOL_REF_TLS_MODEL (sym));
+
+  if (TARGET_V32)
+    {
+      tp = gen_reg_rtx (Pmode);
+      emit_insn (gen_cris_load_tp (tp));
+    }
+  else
+    tp = gen_rtx_REG (Pmode, CRIS_TP_REGNUM);
+
+  if (SYMBOL_REF_TLS_MODEL (sym) == TLS_MODEL_LOCAL_EXEC && !flag_pic)
+    {
+      /* The offset stays out of the constant: movsi takes a CONST of a
+	 PLUS for an address and loads it with lapc.  */
+      off = gen_rtx_UNSPEC (Pmode, gen_rtvec (1, sym), CRIS_UNSPEC_TPOFF);
+      off = force_reg (Pmode, gen_rtx_CONST (Pmode, off));
+    }
+  else
+    {
+      rtx addr, mem;
+
+      if (flag_pic)
+	{
+	  rtx got = force_reg (Pmode,
+			       gen_rtx_CONST (Pmode,
+					      gen_rtx_UNSPEC (Pmode,
+							      gen_rtvec (1, sym),
+							      CRIS_UNSPEC_TPOFFGOT)));
+	  crtl->uses_pic_offset_table = 1;
+	  addr = expand_binop (Pmode, add_optab, got, pic_offset_table_rtx,
+			       NULL_RTX, 0, OPTAB_LIB_WIDEN);
+	}
+      else
+	addr = force_reg (Pmode,
+			  gen_rtx_CONST (Pmode,
+					 gen_rtx_UNSPEC (Pmode,
+							 gen_rtvec (1, sym),
+							 CRIS_UNSPEC_IE)));
+      mem = gen_const_mem (Pmode, addr);
+      off = force_reg (Pmode, mem);
+    }
+
+  res = expand_binop (Pmode, add_optab, tp, off, NULL_RTX, 0,
+		      OPTAB_LIB_WIDEN);
+  if (offs != 0)
+    res = expand_binop (Pmode, add_optab, res, GEN_INT (offs), NULL_RTX, 0,
+			OPTAB_LIB_WIDEN);
+  return force_reg (Pmode, res);
+}
