+/* Unwinding through the frame the kernel builds for a signal handler
+   (arch/metag/kernel/signal.c, setup_rt_frame).  The handler returns to
+   two instructions at the end of struct rt_sigframe, so the return address
+   of the handler's frame points right at them.  */
+
+#ifndef inhibit_libc
+
+#include <signal.h>
+#include <stddef.h>
+#include <sys/ucontext.h>
+
+#define MD_FALLBACK_FRAME_STATE_FOR metag_fallback_frame_state
+
+/* MOV D1Re0, #__NR_rt_sigreturn (139); SWITCH #0x440001 */
+#define METAG_SIGRETURN_MOV	(0x03000004 | (139 << 3))
+#define METAG_SIGRETURN_SWITCH	0xaf440001
+
+/* gcc's register numbers, which are also the DWARF ones: D{n%2}.{n/2}
+   for n < 16, A{u}.{r} at 32 + 2r + u, the PC at 54.  Only some of them
+   have an unwind column (DWARF_REG_TO_UNWIND_COLUMN in metag.h); the PC
+   has one for the signal frame.  */
+#define METAG_DWARF_A0StP	32
+#define METAG_DWARF_PC		54
+
+static void
+metag_save_column (_Unwind_FrameState *fs, int regno, void *addr,
+		   long new_cfa)
+{
+  int column = DWARF_REG_TO_UNWIND_COLUMN (regno);
+
+  if (column < 0)
+    return;			/* caller-saved, the unwinder keeps none */
+  fs->regs.reg[column].how = REG_SAVED_OFFSET;
+  fs->regs.reg[column].loc.offset = (long) addr - new_cfa;
+}
+
+static _Unwind_Reason_Code
+metag_fallback_frame_state (struct _Unwind_Context *context,
+			    _Unwind_FrameState *fs)
+{
+  /* The kernel's own ucontext: its sigset_t is two words, unlike libc's.  */
+  struct kernel_ucontext
+  {
+    unsigned long uc_flags;
+    void *uc_link;
+    stack_t uc_stack;
+    struct sigcontext uc_mcontext;
+    unsigned long uc_sigmask[2];
+  };
+  struct rt_sigframe
+  {
+    siginfo_t info;
+    struct kernel_ucontext uc;
+    unsigned long retcode[2];
+  };
+  unsigned long *pc = context->ra;
+  struct rt_sigframe *frame;
+  struct sigcontext *sc;
+  long new_cfa;
+  int r, u;
+
+  if (pc == NULL
+      || pc[0] != METAG_SIGRETURN_MOV
+      || pc[1] != METAG_SIGRETURN_SWITCH)
+    return _URC_END_OF_STACK;
+
+  frame = (struct rt_sigframe *) ((char *) pc
+				  - offsetof (struct rt_sigframe, retcode));
+  sc = &frame->uc.uc_mcontext;
+
+  new_cfa = sc->regs.ax[0][0];		/* A0StP of the interrupted code */
+  fs->cfa_how = CFA_REG_OFFSET;
+  fs->cfa_reg = METAG_DWARF_A0StP;
+  fs->cfa_offset = new_cfa - (long) context->cfa;
+
+  for (r = 0; r < 8; r++)
+    for (u = 0; u < 2; u++)
+      metag_save_column (fs, 2 * r + u, &sc->regs.dx[r][u], new_cfa);
+  for (r = 0; r < 4; r++)
+    for (u = 0; u < 2; u++)
+      metag_save_column (fs, METAG_DWARF_A0StP + 2 * r + u,
+			 &sc->regs.ax[r][u], new_cfa);
+
+  /* The interrupted PC goes into a column of its own: D1RtP, the normal
+     return column, holds a live value there.  */
+  metag_save_column (fs, METAG_DWARF_PC, &sc->regs.pc, new_cfa);
+  fs->retaddr_column = METAG_DWARF_PC;
+  fs->signal_frame = 1;
+
+  return _URC_NO_REASON;
+}
+
+#endif /* ifdef inhibit_libc  */
--- a/gcc/config/metag/linux.h
+++ b/gcc/config/metag/linux.h
@@ -30,3 +30,8 @@
 
