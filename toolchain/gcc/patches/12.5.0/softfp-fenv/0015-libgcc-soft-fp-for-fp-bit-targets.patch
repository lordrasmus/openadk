diff -Nru a/libgcc/config/csky/t-softfp-csky b/libgcc/config/csky/t-softfp-csky
--- a/libgcc/config/csky/t-softfp-csky
+++ b/libgcc/config/csky/t-softfp-csky
@@ -0,0 +1,3 @@
+# lib1funcs.S has __unordsf2 and __unorddf2 of its own; soft-fp provides
+# them, raising invalid for a signaling NaN.
+LIB1ASMFUNCS := $(filter-out _unorddf2 _unordsf2,$(LIB1ASMFUNCS))
