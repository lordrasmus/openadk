+/* __builtin_eh_return stores the handler address into the return address
+   slot, and only the epilogue reads it back.  Before the epilogue exists,
+   dse1 sees no load and deletes the store, and the unwinder then returns to
+   the old return address instead of the landing pad.  A volatile MEM keeps
+   the store, as for CRIS, PA and Visium (PR middle-end/113109).  */
+
+rtx
+frv_eh_return_handler_rtx (void)
+{
+  rtx ret = frv_return_addr_rtx (0, frame_pointer_rtx);
+  MEM_VOLATILE_P (ret) = 1;
+  return ret;
+}
