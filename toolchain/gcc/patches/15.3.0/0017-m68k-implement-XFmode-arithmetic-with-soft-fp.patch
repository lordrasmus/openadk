+a copy of the GCC Runtime Library Exception along with this program;
+see the files COPYING3 and COPYING.RUNTIME respectively.  If not, see
+<http://www.gnu.org/licenses/>.  */
+
+/* Only the XFmode routines use soft-fp; SFmode and DFmode arithmetic
+   still comes from lb1sf68.S and fpgnulib.c.
+
+   The words are 64 bits wide although the machine is not: XFmode then
+   takes two words, with the top of the significand in the high one,
+   which is the layout the soft-fp operations expect.  With 32-bit
+   words XFmode needs four, and the borrow of a cancelling subtraction
+   is left in the fourth word above _FP_FRAC_HIGH_E.  */
+
+#define _FP_W_TYPE_SIZE		64
+#define _FP_W_TYPE		unsigned long long
+#define _FP_WS_TYPE		signed long long
+#define _FP_I_TYPE		long
+
+#define _FP_MUL_MEAT_E(R,X,Y)				\
+  _FP_MUL_MEAT_2_wide(_FP_WFRACBITS_E,R,X,Y,umul_ppmm)
+#define _FP_DIV_MEAT_E(R,X,Y)	_FP_DIV_MEAT_2_udiv(E,R,X,Y)
+
+/* The default NaN of the 68881: positive, all fraction bits set.  */
+#define _FP_NANFRAC_S		((_FP_QNANBIT_S << 1) - 1)
+#define _FP_NANFRAC_D		((_FP_QNANBIT_D << 1) - 1)
+#define _FP_NANFRAC_E		0, ((_FP_QNANBIT_E << 1) - 1)
+#define _FP_NANSIGN_S		0
+#define _FP_NANSIGN_D		0
+#define _FP_NANSIGN_E		0
+#define _FP_KEEPNANFRACP	1
+#define _FP_QNANNEGATEDP	0
+
+#define _FP_CHOOSENAN(fs, wc, R, X, Y, OP)			\
+  do {								\
+    R##_s = X##_s;						\
+    _FP_FRAC_COPY_##wc(R,X);					\
+    R##_c = FP_CLS_NAN;						\
+  } while (0)
+
+#define _FP_TININESS_AFTER_ROUNDING 0
+
+/* The type of the result of a floating point comparison.  This must
+   match `__libgcc_cmp_return__' in GCC for the target.  */
+typedef int __gcc_CMPtype __attribute__ ((mode (__libgcc_cmp_return__)));
+#define CMPtype __gcc_CMPtype
+
+#define	__LITTLE_ENDIAN	1234
+#define	__BIG_ENDIAN	4321
+#define __BYTE_ORDER	__BIG_ENDIAN
