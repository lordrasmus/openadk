diff -Nru a/gcc/config/frv/frv.h b/gcc/config/frv/frv.h
--- a/gcc/config/frv/frv.h	2026-11-05 00:00:00.000000000 +0000
+++ b/gcc/config/frv/frv.h	2026-11-05 00:00:00.000000000 +0000
@@ -1717,6 +1717,12 @@
 #define DWARF2_UNWIND_INFO 1
 
 #define DWARF_FRAME_RETURN_COLUMN DWARF_FRAME_REGNUM (LR_REGNO)
+
+/* Signal frames (libgcc/config/frv/linux-unwind.h) record the interrupted
+   PC in this column, one past the hard registers, because the LR column
+   must keep the interrupted LR.  Declaring it makes
+   init_dwarf_reg_size_table size the column.  */
+#define DWARF_ALT_FRAME_RETURN_COLUMN FIRST_PSEUDO_REGISTER
 
 /* Assembler Commands for Alignment.  */
 
diff -Nru a/libgcc/config/frv/linux-unwind.h b/libgcc/config/frv/linux-unwind.h
--- a/libgcc/config/frv/linux-unwind.h	2026-11-05 00:00:00.000000000 +0000
+++ b/libgcc/config/frv/linux-unwind.h	2026-11-05 00:00:00.000000000 +0000
@@ -0,0 +1,136 @@
