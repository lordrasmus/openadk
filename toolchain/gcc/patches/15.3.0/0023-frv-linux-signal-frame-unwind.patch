+   <http://www.gnu.org/licenses/>.  */
+
+#ifndef inhibit_libc
+
+/* Do code reading to identify a signal frame, and set the frame state
+   data appropriately.  See unwind-dw2.c for the structs.  */
+
+#include <asm/sigcontext.h>
+#include <asm/unistd.h>
+
+#define MD_FALLBACK_FRAME_STATE_FOR frv_fallback_frame_state
+
+/* The head of the kernel's struct rt_sigframe
+   (arch/frv/kernel/signal.c).  */
+struct frv_rt_sigframe_head
+{
+  void *pretcode;
+  int sig;
+  void *pinfo;
+  void *puc;
+};
+
+/* The head of the kernel's struct sigframe, used without SA_SIGINFO.  */
+struct frv_sigframe_head
+{
+  void *pretcode;
+  int sig;
+  struct sigcontext sc;
+};
+
+/* The kernel's struct ucontext up to uc_mcontext.  */
+struct frv_kernel_ucontext
+{
+  unsigned long uc_flags;
+  void *uc_link;
+  void *ss_sp;
+  int ss_flags;
+  unsigned long ss_size;
+  struct sigcontext uc_mcontext;
+};
+
+/* DWARF column of the link register (LR_REGNO in gcc/config/frv/frv.h).  */
+#define FRV_LR_COLUMN 169
+
+static _Unwind_Reason_Code
+frv_fallback_frame_state (struct _Unwind_Context *context,
+			  _Unwind_FrameState *fs)
+{
+  const unsigned int *pc = (const unsigned int *) context->ra;
+  struct sigcontext *sc;
+  struct user_int_regs *regs;
+  _Unwind_Ptr new_cfa;
+  int i;
+
+  if ((unsigned long) pc < 4096)
+    return _URC_END_OF_STACK;
+
+  /* The kernel writes the trampoline into the signal frame and points
+     the handler's LR at it:
+
+	setlos	#__NR_rt_sigreturn, gr7		(or __NR_sigreturn)
+	tira	gr0, #0
+
+     The handler is entered with sp at the frame, which is its CFA.  */
+  if (pc[1] != 0xc0700000)
+    return _URC_END_OF_STACK;
+  if (pc[0] == (0x8efc0000 | __NR_rt_sigreturn))
+    {
+      struct frv_rt_sigframe_head *frame = context->cfa;
+
+      if (frame->pretcode != (void *) pc)
+	return _URC_END_OF_STACK;
+      sc = &((struct frv_kernel_ucontext *) frame->puc)->uc_mcontext;
+    }
+  else if (pc[0] == (0x8efc0000 | __NR_sigreturn))
+    {
+      struct frv_sigframe_head *frame = context->cfa;
+
+      if (frame->pretcode != (void *) pc)
+	return _URC_END_OF_STACK;
+      sc = &frame->sc;
+    }
+  else
+    return _URC_END_OF_STACK;
+
+  regs = &sc->sc_context.i;
+
+  new_cfa = regs->gr[1];
+  fs->regs.cfa_how = CFA_REG_OFFSET;
+  fs->regs.cfa_reg = 1;		/* gr1, the stack pointer.  */
+  fs->regs.cfa_offset = new_cfa - (_Unwind_Ptr) context->cfa;
+
+  /* gr[0] shares its slot with tbr; gr0 itself is always zero.  */
+  for (i = 1; i < 64; i++)
+    {
+      fs->regs.how[i] = REG_SAVED_OFFSET;
+      fs->regs.reg[i].loc.offset = (_Unwind_Ptr) &regs->gr[i] - new_cfa;
+    }
+
+  fs->regs.how[FRV_LR_COLUMN] = REG_SAVED_OFFSET;
+  fs->regs.reg[FRV_LR_COLUMN].loc.offset = (_Unwind_Ptr) &regs->lr - new_cfa;
+
+  /* The interrupted PC goes into the alternate return column, because the
+     LR column above keeps the interrupted LR.  */
+  fs->regs.how[__LIBGCC_DWARF_ALT_FRAME_RETURN_COLUMN__] = REG_SAVED_OFFSET;
+  fs->regs.reg[__LIBGCC_DWARF_ALT_FRAME_RETURN_COLUMN__].loc.offset
+    = (_Unwind_Ptr) &regs->pc - new_cfa;
+  fs->retaddr_column = __LIBGCC_DWARF_ALT_FRAME_RETURN_COLUMN__;
+  fs->signal_frame = 1;
+
+  return _URC_NO_REASON;
+}
+
+#endif
